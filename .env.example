# Copy this file to `.env` and fill in only what you need.
# Everything here is optional — the app starts offline on embedded PGlite with no keys.
# `.env` is git-ignored. Never commit real credentials.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use embedded PGlite at PGLITE_DIR.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/afi
# PGLITE_DIR=.data/postgres
# REQUIRE_STANDARD_POSTGRES=false

# --- HTTP -------------------------------------------------------------------
# Must exactly match the origin you actually browse, otherwise write requests are
# rejected by the same-origin check. Default: http://127.0.0.1:3100
# APP_ORIGIN=http://127.0.0.1:3100

# --- Source connectors ------------------------------------------------------
# Optional read-only GitHub token; raises the REST rate limit. Everything works without it.
# GITHUB_TOKEN=

# --- Optional model features ------------------------------------------------
# Without these, all evidence features work and model-assisted extras report UNAVAILABLE.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=
# LLM_DAILY_BUDGET_USD=0.10
# LLM_USER_DAILY_BUDGET_USD=0.03
# LLM_MAX_CALLS_PER_DAY=100
